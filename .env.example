# Three keys.

# Neon — use the POOLED connection string (the host contains `-pooler`).
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Signs the session cookie. Any 32+ random bytes: `openssl rand -base64 48`.
# Rotating this logs everybody out, which is the intended emergency lever.
SESSION_SECRET=

# aistudio.google.com -> Get API key. Free tier: no card on file, 1500
# requests/day on the Flash models this app uses. Powers chat (rewrite,
# rerank, grade, answer) and embeddings — one key, one provider.
GOOGLE_API_KEY=
