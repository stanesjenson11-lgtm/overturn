# Five keys, and two optional settings.

# Neon — use the POOLED connection string (the host contains `-pooler`).
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Signs the session cookie. Any 32+ random bytes: `openssl rand -base64 48`.
# Rotating this logs everybody out, which is the intended emergency lever.
SESSION_SECRET=

# aistudio.google.com -> Get API key. Free tier: no card on file, 1500
# requests/day on the Flash models this app uses. Powers chat (rewrite,
# rerank, grade, answer) and embeddings — one key, one provider.
GOOGLE_API_KEY=

# Encrypts messages, verdicts, case titles, file names and key terms in the
# database (lib/crypto.ts). 32 random bytes: `openssl rand -base64 32`.
# Losing it loses every encrypted row; rotating it needs a re-encrypt (SECURITY.md).
DATA_KEY=

# Cloudflare Turnstile (dash.cloudflare.com -> Turnstile -> Add widget).
# These are Cloudflare's public TEST keys, which always pass: fine for local
# dev, replace both in production. Production refuses sign-ins without a secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Shown on /privacy as the grievance contact.
CONTACT_EMAIL=

# Set to true only once GOOGLE_API_KEY belongs to a billing-enabled project.
# On the free tier Google may use prompts to improve its products, so the app
# runs as a demo for sample documents until this is true.
LLM_PAID_TIER=
